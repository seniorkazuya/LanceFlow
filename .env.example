# Database (Neon staging / local Docker — see documents/docs/DEPLOY_STAGING.md)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lanceflow?schema=public"

# Redis (integration tests, jobs — start with docker compose up -d)
REDIS_URL="redis://localhost:6379"

# Optional MinIO (docker compose --profile storage up -d)
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET="lanceflow"

# Observability (DEV-007) — optional; omit to disable Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG="" SENTRY_PROJECT=""  # optional, for Sentry webpack upload

# Auth (CORE-002) — required for NextAuth; generate with: openssl rand -base64 32
AUTH_SECRET=""
# Dev/staging credentials provider (omit in production unless you intend dev login)
DEV_AUTH_EMAIL="ops@lanceflow.test"
DEV_AUTH_PASSWORD="change-me-local-only"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
