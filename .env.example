# Database — pick one:
# Local Docker (after: docker compose up -d):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lanceflow?schema=public"
# No Docker: paste Neon staging URL from console.neon.tech (see documents/docs/LOCAL_DEV_WINDOWS.md)

# Redis (optional locally — omit for skipped health check)
REDIS_URL="redis://localhost:6379"

# Optional MinIO (docker compose --profile storage up -d)
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET="lanceflow"

# Observability (DEV-007) — optional; omit to disable Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG="" SENTRY_PROJECT=""  # optional, for Sentry webpack upload

# Auth (CORE-002) — required for NextAuth
AUTH_SECRET=""
DEV_AUTH_EMAIL="ops@lanceflow.test"
DEV_AUTH_PASSWORD="change-me-local-only"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Automation (AUTO-003) — auto-assign top engineer when project becomes active
AUTO_ASSIGN_ENABLED="false"

# Payment escalation jobs (AUTO-005) — BullMQ worker + daily cron
PAYMENT_ESCALATION_JOBS_ENABLED="false"
PAYMENT_ESCALATION_CRON="0 8 * * *"
PAYMENT_ESCALATION_NOTIFY_EMAIL="false"

# Notifications (AUTO-007) — Resend when set; otherwise in-app only (noop email)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="LanceFlow <notifications@lanceflow.app>"
