// CORE-001 — users and audit_logs (v0). Extend in later stories.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String       @map("display_name")
  role        String
  status      String       @default("active")
  skillTags   String[]     @default([]) @map("skill_tags")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments Assignment[]
  dailyReports  DailyReport[]
  notifications Notification[]
  kpiRecords    KpiRecord[]
  compensationSuggestions CompensationSuggestion[]

  @@map("users")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  contactEmail       String?  @map("contact_email")
  status             String   @default("active")
  riskScore          Int      @default(0) @map("risk_score")
  riskScoreSource    String   @default("default") @map("risk_score_source")
  riskFormulaVersion String?  @map("risk_formula_version")
  riskOverrideReason String?  @map("risk_override_reason")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  projects           Project[]

  @@map("ops_clients")
}

model Project {
  id                 String   @id @default(cuid())
  clientId           String   @map("client_id")
  title              String
  status             String   @default("draft")
  scopeClarityPct    Int?     @map("scope_clarity_pct")
  profitMarginPct    Int?     @map("profit_margin_pct")
  clientRiskAtCreate Int?      @map("client_risk_at_create")
  escrowHeld         Boolean   @default(false) @map("escrow_held")
  escrowOverrideReason String? @map("escrow_override_reason")
  escrowOverrideBy   String?   @map("escrow_override_by")
  escrowOverrideAt   DateTime? @map("escrow_override_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  client             Client   @relation(fields: [clientId], references: [id])
  assignments        Assignment[]
  dailyReports       DailyReport[]
  paymentSchedules   PaymentSchedule[]
  milestones         ProjectMilestone[]
  disputes           ProjectDispute[]

  @@map("ops_projects")
}

/// PAY-005 — payment/client dispute workflow with CEO escalation on high value.
model ProjectDispute {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  title          String
  description    String?
  amountCents    Int       @map("amount_cents")
  currency       String    @default("USD")
  status         String    @default("open")
  sopLinkId      String?   @map("sop_link_id")
  escalatedAt    DateTime? @map("escalated_at")
  escalatedBy    String?   @map("escalated_by")
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     String?   @map("resolved_by")
  resolutionNote String?   @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("project_disputes")
}

/// PAY-001 — payment milestone % breakdown per project (must sum to 100).
model ProjectMilestone {
  id              String           @id @default(cuid())
  projectId       String           @map("project_id")
  label           String
  percentPct      Int              @map("percent_pct")
  dueDate         DateTime?        @db.Date @map("due_date")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentSchedule PaymentSchedule?

  @@index([projectId])
  @@map("project_milestones")
}

model PaymentSchedule {
  id              String            @id @default(cuid())
  projectId       String            @map("project_id")
  milestoneId     String?           @unique @map("milestone_id")
  dueDate         DateTime          @db.Date @map("due_date")
  amountCents     Int               @map("amount_cents")
  currency        String            @default("USD")
  status          String            @default("scheduled")
  escalationLevel Int               @default(0) @map("escalation_level")
  paidAt          DateTime?         @map("paid_at")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  project         Project           @relation(fields: [projectId], references: [id])
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId, dueDate])
  @@map("payment_schedules")
}

model Assignment {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  userId         String    @map("user_id")
  skillScore     Int?      @map("skill_score")
  formulaVersion String?   @map("formula_version")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  releasedAt     DateTime? @map("released_at")
  project    Project   @relation(fields: [projectId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("ops_assignments")
}

model DailyReport {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  projectId   String   @map("project_id")
  reportDate  DateTime @db.Date @map("report_date")
  hours       Float    @map("hours")
  progressPct Int      @map("progress_pct")
  issues      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId, reportDate])
  @@map("ops_daily_reports")
}

model LeadershipException {
  id             String    @id @default(cuid())
  sourceKey      String    @unique @map("source_key")
  severity       String
  category       String
  title          String
  summary        String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  status         String    @default("open")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, severity])
  @@map("leadership_exceptions")
}

model KpiRecord {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  role           String
  periodKey      String   @map("period_key")
  periodStart    DateTime @db.Date @map("period_start")
  periodEnd      DateTime @db.Date @map("period_end")
  formulaVersion String   @map("formula_version")
  score          Int
  components     Json
  computedAt     DateTime @default(now()) @map("computed_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([periodKey])
  @@map("kpi_records")
}

/// KPI-005 — green/yellow/red bands per control-center metric (CEO configures).
model KpiSignalThreshold {
  metricKey  String   @id @map("metric_key")
  direction  String
  greenMin   Int?     @map("green_min")
  yellowMin  Int?     @map("yellow_min")
  greenMax   Int?     @map("green_max")
  yellowMax  Int?     @map("yellow_max")
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("kpi_signal_thresholds")
}

/// KPI-006 — Ops-reviewed bonus/penalty suggestions from weekly KPI (not payroll).
model CompensationSuggestion {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  periodKey      String    @map("period_key")
  kind           String
  percentBps     Int       @map("percent_bps")
  kpiScore       Int       @map("kpi_score")
  formulaVersion String    @map("formula_version")
  inputs         Json
  status         String    @default("pending")
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewNote     String?   @map("review_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([status, periodKey])
  @@map("compensation_suggestions")
}

model RuleDecision {
  id             String   @id @default(cuid())
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  ruleKey        String   @map("rule_key")
  formulaVersion String   @map("formula_version")
  inputs         Json
  outcome        String
  explanation    Json?
  overridden     Boolean  @default(false)
  actorId        String?  @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("rule_decisions")
}
