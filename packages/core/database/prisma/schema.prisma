// CORE-001 — users and audit_logs (v0). Extend in later stories.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String       @map("display_name")
  role        String
  status      String       @default("active")
  skillTags   String[]     @default([]) @map("skill_tags")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments Assignment[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  contactEmail       String?  @map("contact_email")
  status             String   @default("active")
  riskScore          Int      @default(0) @map("risk_score")
  riskScoreSource    String   @default("default") @map("risk_score_source")
  riskFormulaVersion String?  @map("risk_formula_version")
  riskOverrideReason String?  @map("risk_override_reason")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  projects           Project[]

  @@map("ops_clients")
}

model Project {
  id                 String   @id @default(cuid())
  clientId           String   @map("client_id")
  title              String
  status             String   @default("draft")
  scopeClarityPct    Int?     @map("scope_clarity_pct")
  profitMarginPct    Int?     @map("profit_margin_pct")
  clientRiskAtCreate Int?     @map("client_risk_at_create")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  client             Client   @relation(fields: [clientId], references: [id])
  assignments        Assignment[]

  @@map("ops_projects")
}

model Assignment {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  userId         String    @map("user_id")
  skillScore     Int?      @map("skill_score")
  formulaVersion String?   @map("formula_version")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  releasedAt     DateTime? @map("released_at")
  project    Project   @relation(fields: [projectId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("ops_assignments")
}
