// CORE-001 — users and audit_logs (v0). Extend in later stories.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String       @map("display_name")
  role        String
  status      String       @default("active")
  skillTags   String[]     @default([]) @map("skill_tags")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments Assignment[]
  dailyReports  DailyReport[]
  notifications Notification[]

  @@map("users")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  contactEmail       String?  @map("contact_email")
  status             String   @default("active")
  riskScore          Int      @default(0) @map("risk_score")
  riskScoreSource    String   @default("default") @map("risk_score_source")
  riskFormulaVersion String?  @map("risk_formula_version")
  riskOverrideReason String?  @map("risk_override_reason")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  projects           Project[]

  @@map("ops_clients")
}

model Project {
  id                 String   @id @default(cuid())
  clientId           String   @map("client_id")
  title              String
  status             String   @default("draft")
  scopeClarityPct    Int?     @map("scope_clarity_pct")
  profitMarginPct    Int?     @map("profit_margin_pct")
  clientRiskAtCreate Int?     @map("client_risk_at_create")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  client             Client   @relation(fields: [clientId], references: [id])
  assignments        Assignment[]
  dailyReports       DailyReport[]
  paymentSchedules   PaymentSchedule[]

  @@map("ops_projects")
}

model PaymentSchedule {
  id              String    @id @default(cuid())
  projectId       String    @map("project_id")
  dueDate         DateTime  @db.Date @map("due_date")
  amountCents     Int       @map("amount_cents")
  currency        String    @default("USD")
  status          String    @default("scheduled")
  escalationLevel Int       @default(0) @map("escalation_level")
  paidAt          DateTime? @map("paid_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  project         Project   @relation(fields: [projectId], references: [id])

  @@index([projectId, dueDate])
  @@map("payment_schedules")
}

model Assignment {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  userId         String    @map("user_id")
  skillScore     Int?      @map("skill_score")
  formulaVersion String?   @map("formula_version")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  releasedAt     DateTime? @map("released_at")
  project    Project   @relation(fields: [projectId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("ops_assignments")
}

model DailyReport {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  projectId   String   @map("project_id")
  reportDate  DateTime @db.Date @map("report_date")
  hours       Float    @map("hours")
  progressPct Int      @map("progress_pct")
  issues      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId, reportDate])
  @@map("ops_daily_reports")
}

model RuleDecision {
  id             String   @id @default(cuid())
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  ruleKey        String   @map("rule_key")
  formulaVersion String   @map("formula_version")
  inputs         Json
  outcome        String
  explanation    Json?
  overridden     Boolean  @default(false)
  actorId        String?  @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("rule_decisions")
}
